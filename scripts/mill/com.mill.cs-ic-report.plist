<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Weekly standing IC report (SESSION-R2-IC-HARNESS).

     STAGED - NOT LOADED. Installing it is a supervised human step; see the
     runbook block in RESULT_R2_IC_HARNESS. No code session loads launchd jobs.

       cp scripts/mill/com.mill.cs-ic-report.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/com.mill.cs-ic-report.plist

     Sundays 18:30 mill-local, 30 minutes after the 18:00 gate read, so the two
     Pushover messages arrive in the order a human reads them: the gate verdict
     first, then the signal-decay context behind it.

     Requires a Python 3.11 venv at ~/.venvs/icharness (mill's system python3 is
     3.9 and cannot run the harness). Reads the nightly DB pull read-only and
     writes append-only into ~/mill-local-edits/ic-reports.

     Network: opens no listener. The single outbound connection is Pushover over
     the existing path used by the gate read. The droplet is never contacted. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mill.cs-ic-report</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>$HOME/cyberscreener/scripts/mill/ic_report_weekly.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>18</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/cs-ic-report.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/cs-ic-report.err</string>
</dict>
</plist>
