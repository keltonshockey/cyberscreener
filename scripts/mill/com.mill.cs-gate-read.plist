<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Weekly gate read (SESSION-GATE-PREREG). STAGED - operator installs:
       cp scripts/mill/com.mill.cs-gate-read.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/com.mill.cs-gate-read.plist
     Sundays 18:00 mill-local, after the week's expiries have settled.
     First meaningful run: Sunday 2026-06-21 (post 6/18 closure wave). -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mill.cs-gate-read</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>$HOME/cyberscreener/scripts/mill/gate_read_weekly.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>18</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/cs-gate-read.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/cs-gate-read.err</string>
</dict>
</plist>
